# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Used for: score generation, OCR extraction, AND generating embeddings for Vector Store
GEMINI_API_KEY=your-gemini-api-key-here

# ─── ChromaDB / Vector Store ───────────────────────────────────────────────────
# If set to http://localhost:8001, connects to external ChromaDB server if running.
# If external server is not reachable, automatically falls back to Embedded Persistent
# Vector Store (vector_cache.json) — ZERO external processes or pip install required!
CHROMA_URL=http://localhost:8001

# Collection name in ChromaDB
CHROMA_COLLECTION=score_recommendations

# ─── Server ────────────────────────────────────────────────────────────────────
# Port the Node.js backend listens on (4000 avoids conflict with Python backend on 8000)
PORT=4000

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin — ONLY this origin is allowed (no wildcard in production)
FRONTEND_ORIGIN=http://localhost:5173

# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
