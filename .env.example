# Root .env - used by Vite dev server OCR plugin (vite.config.js)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Vite exposes vars prefixed with VITE_ to the browser (frontend)
# Do NOT put secret keys with VITE_ prefix — they will be exposed in browser bundle
VITE_GEMINI_API_KEY=your-gemini-api-key-here
